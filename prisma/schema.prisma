// schema.prisma
// This Prisma schema defines the PostgreSQL database models and relationships for the HRMS backend.
// It is responsible for structuring entities like User, Employee, Department, Attendance, and LeaveRequest and mapping them to the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @db.Uuid
  email     String    @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole  @default(EMPLOYEE)
  isActive  Boolean   @default(false)
  activationToken    String?  @unique
  resetToken         String?
  resetTokenExpiry   DateTime?
  employee  Employee?
  createdTasks Task[]
  sessions  UserSession[]
  userPermissions UserPermission[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Department {
  id          String     @id @db.Uuid
  name        String     @unique
  description String?
  headEmployeeId String?   @db.Uuid
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  employees      Employee[] @relation("DepartmentMembers")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Employee {
  id             String         @id @db.Uuid
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?
  countryCode    String?
  mobileNumber   String?
  profileUrl     String?
  documents      Json?
  hireDate       DateTime       @default(now())
  status         EmploymentStatus @default(ACTIVE)
  departmentId   String?        @db.Uuid
  department     Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headsDepartments Department[] @relation("DepartmentHead")
  userId         String?        @db.Uuid @unique
  user           User?          @relation(fields: [userId], references: [id])
  managerId      String?        @db.Uuid
  manager        Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates   Employee[]     @relation("EmployeeManager")
  attendances    Attendance[]
  salaryRecords  SalaryRecord[]
  leaveRequests  LeaveRequest[]
  approvedLeaves LeaveRequest[] @relation("LeaveApprover")
  assignedTasks  Task[]         @relation("TaskAssignee")
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Task {
  id              String           @id @db.Uuid
  title           String
  description     String
  assignedToId    String           @db.Uuid
  assignedTo      Employee         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdByUserId String           @db.Uuid
  createdBy       User             @relation(fields: [createdByUserId], references: [id])
  assignedByRole  TaskAssignerRole
  dueDate         DateTime
  priority        TaskPriority
  status          TaskStatus       @default(TODO)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Attendance {
  id         String           @id @db.Uuid
  employeeId String           @db.Uuid
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now())
}

model LeaveRequest {
  id         String       @id @db.Uuid
  employeeId String       @db.Uuid
  employee   Employee     @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime
  type       LeaveType
  status     LeaveStatus  @default(PENDING)
  reason     String?
  approverId String?      @db.Uuid
  approver   Employee?    @relation("LeaveApprover", fields: [approverId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model SalaryRecord {
  id               String       @id @db.Uuid
  employeeId       String       @db.Uuid
  employee         Employee     @relation(fields: [employeeId], references: [id])
  month            String
  year             Int
  workingDays      Int
  payableDays      Int
  status           SalaryStatus @default(DRAFT)
  pfEmployeeRate   Float
  pfEmployerRate   Float
  esiRate          Float
  tdsRate          Float
  basic            Float
  hra              Float
  allowances       Float
  bonus            Float
  otherEarnings    Float
  otherDeductions  Float
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([employeeId, month, year])
}

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

model Permission {
  id          String    @id @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  userPermissions UserPermission[]
}

model UserPermission {
  id           String     @id @db.Uuid
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @db.Uuid

  @@unique([userId, permissionId])
}

model UserSession {
  id           String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @db.Uuid
  refreshToken String
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  MANAGER_PENDING
  HR_PENDING
  APPROVED
  REJECTED
}

enum SalaryStatus {
  DRAFT
  PROCESSED
  PAID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskAssignerRole {
  MANAGER
  HR
}

